APP_NAME=BMO System
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_RELOAD=true
API_PREFIX=/api/v1
ROOT_ROUTE=/
ROOT_HEALTH_ROUTE=/health

ASSETS_DIR=Assets
ASSETS_UPLOADS_DIR=Assets/uploads
ASSETS_STT_DIR=Assets/stt
ASSETS_CV_DIR=Assets/cv
ASSETS_TTS_DIR=Assets/tts
ASSETS_LLM_DIR=Assets/llm

STT_ROUTE_PREFIX=/stt
STT_HEALTH_ROUTE=/health
STT_CONFIG_ROUTE=/config
STT_TRANSCRIBE_ROUTE=/transcribe
STT_PROVIDER=local
STT_MODEL_NAME=faster-whisper
STT_DEFAULT_LANGUAGE=en
STT_BEAM_SIZE=5
STT_TEMPERATURE=0.0

CV_ROUTE_PREFIX=/cv
CV_HEALTH_ROUTE=/health
CV_CONFIG_ROUTE=/config
CV_ANALYZE_ROUTE=/analyze
CV_PROVIDER=local
CV_MODEL_NAME=yolov8n
CV_DEFAULT_TASK=describe
CV_CONFIDENCE_THRESHOLD=0.35

LLM_ROUTE_PREFIX=/llm
LLM_HEALTH_ROUTE=/health
LLM_CONFIG_ROUTE=/config
LLM_CHAT_ROUTE=/chat
LLM_PROVIDER=groq
LLM_MODEL_NAME=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=512
LLM_USE_REMOTE=false
LLM_ENDPOINT=/chat/completions

TTS_ROUTE_PREFIX=/tts
TTS_HEALTH_ROUTE=/health
TTS_CONFIG_ROUTE=/config
TTS_SYNTHESIZE_ROUTE=/synthesize
TTS_PROVIDER=groq
TTS_MODEL_NAME=playai-tts
TTS_DEFAULT_VOICE=alloy
TTS_OUTPUT_FORMAT=mp3
TTS_USE_REMOTE=false
TTS_ENDPOINT=/audio/speech

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_SECONDS=45
