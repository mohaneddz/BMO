APP_NAME=BMO System
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_RELOAD=true
API_PREFIX=/api/v1
ROOT_ROUTE=/
ROOT_HEALTH_ROUTE=/health

ASSETS_DIR=.
ASSETS_UPLOADS_DIR=STT/assets/uploads
ASSETS_STT_DIR=STT/assets
ASSETS_CV_DIR=CV/assets
ASSETS_TTS_DIR=TTS/assets
ASSETS_LLM_DIR=LLM/assets

STT_ROUTE_PREFIX=/stt
STT_HEALTH_ROUTE=/health
STT_CONFIG_ROUTE=/config
STT_TRANSCRIBE_ROUTE=/transcribe
STT_PROVIDER=local
STT_MODEL_NAME=base
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
STT_DEFAULT_LANGUAGE=en
STT_BEAM_SIZE=5
STT_TEMPERATURE=0.0

CV_ROUTE_PREFIX=/cv
CV_HEALTH_ROUTE=/health
CV_CONFIG_ROUTE=/config
CV_ANALYZE_ROUTE=/analyze
CV_PROVIDER=local
CV_MODEL_NAME=yolo26n
CV_WEIGHTS_DIR=CV/weights
CV_CONFIDENCE_THRESHOLD=0.35

LLM_ROUTE_PREFIX=/llm
LLM_HEALTH_ROUTE=/health
LLM_CONFIG_ROUTE=/config
LLM_CHAT_ROUTE=/chat
LLM_PROVIDER=groq
LLM_MODEL_NAME=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=512
LLM_USE_REMOTE=false
LLM_ENDPOINT=/chat/completions

TTS_ROUTE_PREFIX=/tts
TTS_HEALTH_ROUTE=/health
TTS_CONFIG_ROUTE=/config
TTS_SYNTHESIZE_ROUTE=/synthesize
TTS_PROVIDER=local
TTS_MODEL_NAME=pocket-tts
TTS_DEFAULT_VOICE=clip-small
TTS_OUTPUT_FORMAT=wav
TTS_USE_REMOTE=false
TTS_ENDPOINT=/audio/speech
TTS_LOCAL_ENABLED=true
TTS_LOCAL_DEFAULT_TEXT=BMO says: Adventure time! Let's explore and have fun.
TTS_LOCAL_DEFAULT_MODE=small
TTS_LOCAL_OUT_DIR=TTS/assets/out
TTS_LOCAL_USE_WARM_ENGINE=true
TTS_POCKET_MODEL_CONFIG=b6369a24
TTS_POCKET_TEMPERATURE=0.7
TTS_POCKET_LSD_DECODE_STEPS=1
TTS_POCKET_NOISE_CLAMP=
TTS_POCKET_EOS_THRESHOLD=-4.0
TTS_POCKET_MAX_TOKENS=1200
TTS_POCKET_MIN_TOKENS=120
TTS_POCKET_DYNAMIC_MAX_TOKENS=true
TTS_POCKET_TOKENS_PER_CHAR=4.0
TTS_POCKET_FRAMES_AFTER_EOS=4
TTS_POCKET_TORCH_THREADS=8
TTS_POCKET_VOICE_DIR=TTS/assets/voice
TTS_POCKET_CLIP_SMALL_PATH=TTS/assets/voice/1.wav
TTS_POCKET_CLIP_MEDIUM_PATH=TTS/assets/voice/2.wav
TTS_POCKET_CLIP_LARGE_PATH=TTS/assets/voice/3.wav

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_SECONDS=45
